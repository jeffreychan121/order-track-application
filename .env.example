DATABASE_URL=
AUSTRALIA_POST_API_KEY=
AUSTRALIA_POST_API_PASSWORD=
# Pricing uses the eParcel and International account; falls back to the legacy shared account below.
AUSTRALIA_POST_PRICING_ACCOUNT_NUMBER=
AUSTRALIA_POST_PRICING_ACCOUNT_LABEL=eParcel and International
# Optional JSON account profiles; when set, each profile references account and credential environment variables.
AUSTRALIA_POST_ACCOUNT_PROFILES_JSON='[{"id":"eparcel-international","label":"eParcel and International","account_number_env":"AUSTRALIA_POST_PRICING_ACCOUNT_NUMBER","default_for_pricing":true},{"id":"same-day-services","label":"Same Day Services","account_number_env":"AUSTRALIA_POST_ACCOUNT_SAME_DAY"},{"id":"st-premium-express","label":"ST Premium and ST Express","account_number_env":"AUSTRALIA_POST_ACCOUNT_ST_PREMIUM_EXPRESS"},{"id":"on-demand","label":"On Demand (OD)","account_number_env":"AUSTRALIA_POST_ACCOUNT_ON_DEMAND"}]'
AUSTRALIA_POST_ACCOUNT_SAME_DAY=
AUSTRALIA_POST_ACCOUNT_ST_PREMIUM_EXPRESS=
AUSTRALIA_POST_ACCOUNT_ON_DEMAND=
# Optional: use a separate authorized account for Track Items; falls back to the legacy shared account, then pricing account.
AUSTRALIA_POST_TRACKING_ACCOUNT_NUMBER=
# Legacy shared account fallback for existing local configurations.
AUSTRALIA_POST_ACCOUNT_NUMBER=
AUSTRALIA_POST_BASE_URL=
TNT_RTT_USERNAME=
TNT_RTT_PASSWORD=
TNT_RTT_ACCOUNT_NUMBER=
